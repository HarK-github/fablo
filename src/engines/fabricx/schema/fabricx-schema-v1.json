{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://fablo.io/schemas/fabricx-schema-v1.json",
  "type": "object",
  "required": ["$schema", "global", "fabricx"],
  "properties": {
    "$schema": {
      "type": "string",
      "const": "https://fablo.io/schemas/fabricx-schema-v1.json"
    },
    "global": {
      "type": "object",
      "required": ["fabricVersion"],
      "properties": {
        "fabricVersion": { "type": "string" },
        "tls": { "type": "boolean" }
      }
    },
    "fabricx": {
      "type": "object",
      "required": ["namespace", "infrastructure", "organizations"],
      "properties": {
        "channelId": { "type": "string" },
        "channel": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": { "type": "string" },
            "profile": { "type": "string" },
            "policy": { "type": "string" }
          },
          "additionalProperties": false
        },
        "namespace": { "type": "string" },
        "infrastructure": {
          "type": "object",
          "required": ["image"],
          "properties": {
            "image": { "type": "string" },
            "toolsImage": { "type": "string" },
            "containerName": { "type": "string" },
            "ports": {
              "type": "object",
              "properties": {
                "sidecar": { "type": "integer" },
                "query": { "type": "integer" },
                "orderer": { "type": "integer" },
                "database": { "type": "integer" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "organizations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "mspId", "domain"],
            "properties": {
              "name": { "type": "string" },
              "mspId": { "type": "string" },
              "domain": { "type": "string" },
              "peerName": { "type": "string" },
              "adminUser": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "type", "apiPort", "p2pPort"],
            "properties": {
              "id": { "type": "string" },
              "type": { "enum": ["issuer", "endorser", "owner"] },
              "apiPort": { "type": "integer" },
              "p2pPort": { "type": "integer" },
              "wallets": {
                "type": "array",
                "items": { "type": "string" }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["channel"] },
        { "required": ["channelId"] }
      ]
    }
  },
  "additionalProperties": false
}
